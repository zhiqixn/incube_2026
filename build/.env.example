COMPOSE_PROJECT_NAME=cpl
AGENT_VERSION=0.0.1


#----- Weaviate Configs -----#
WEAVIATE_VERSION=1.31.2
WEAVIATE_HOST=weaviate
WEAVIATE_HTTP_PORT=8081 # Host Port
WEAVIATE_GRPC_PORT=50051

PROMETHEUS_HOST=weaviate
PROMETHEUS_PORT=2112 # Host Port


#----- Phoenix Configs -----#
PHOENIX_VERSION=version-10.15.0
PHOENIX_ENDPOINT=http://cpl-phoenix-1:6006/v1/traces


#----- Agent Model Configs -----#
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=

LANGSMITH_TRACING=
LANGSMITH_API_KEY=

S3_ENDPOINT=http://host.docker.internal:9000
# Address used in presigned URLs sent to external clients (e.g. VLM server).
# Must be reachable from the model server host, not just from inside Docker.
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin